<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Allow cleartext HTTP so the app can reach Firebase emulator endpoints
         (Auth on port 9099, Firestore on port 8080) from the Android emulator
         in debug builds. Android 9+ blocks cleartext traffic by default.
         This flag must never appear in the main or release manifests. -->
    <application android:usesCleartextTraffic="true">
        <!-- Remove the Firebase auto-init content provider in debug builds so
             that integration tests can call Firebase.initializeApp() and
             useAuthEmulator() before any Auth state listener is attached.
             Without this, the Android plugin attaches a listener before Dart
             code runs, causing useAuthEmulator() to throw IllegalStateException.
             The app's main.dart calls Firebase.initializeApp() explicitly, so
             auto-init is not needed. Release builds keep the provider via the
             main AndroidManifest. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            android:exported="false"
            tools:node="remove" />
    </application>
</manifest>
